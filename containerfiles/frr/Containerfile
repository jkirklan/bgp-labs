# FRR routing image based on AlmaLinux 9.
# UBI 9 cannot be used — FRR's EPEL deps require CRB (CodeReady Builder), unavailable on UBI.
# FRR installs to /usr/libexec/frr/ on EL9 (not /usr/sbin/).
# watchfrr monitors child daemons and runs in foreground — correct PID 1.
FROM docker.io/library/almalinux:9

LABEL org.opencontainers.image.title="frr" \
      org.opencontainers.image.description="FRR routing daemon for BGP labs" \
      org.opencontainers.image.source="https://github.com/jkirklan/bgp-labs"

USER root

# EPEL provides FRR; AlmaLinux 9 CRB repo satisfies its dependencies
RUN dnf install -y epel-release && \
    dnf install -y --nodocs --setopt=install_weak_deps=0 frr && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Runtime directories owned by frr
RUN mkdir -p /var/run/frr /var/log/frr && \
    chown frr:frr /var/run/frr /var/log/frr && \
    chmod 750 /etc/frr

COPY daemons /etc/frr/daemons
COPY docker-start.sh /usr/local/bin/docker-start.sh
RUN chmod +x /usr/local/bin/docker-start.sh

# Runtime caps required: --cap-add NET_ADMIN --cap-add NET_RAW --cap-add SYS_ADMIN
ENTRYPOINT ["/usr/local/bin/docker-start.sh"]
