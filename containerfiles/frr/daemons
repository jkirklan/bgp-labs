# FRR daemon enable/disable configuration
# Uncomment and set to 'yes' to enable each daemon.
# Restart the container after changes.
zebra=yes
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=yes
fabricd=no
vrrpd=no
pathd=no
staticd=yes

# Watchfrr options
watchfrr_enable=yes
watchfrr_options=""

# FRR logging
frr_profile="traditional"
